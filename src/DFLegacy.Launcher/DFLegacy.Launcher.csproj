<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DFLegacy.Launcher</AssemblyName>
    <ApplicationIcon>DFLegacy.Launcher.ico</ApplicationIcon>
    <Ijl15ProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\DFLegacy.Ijl15'))</Ijl15ProjectDirectory>
    <Ijl15BuildScript>$(Ijl15ProjectDirectory)\build-native.ps1</Ijl15BuildScript>
    <Ijl15Output>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\native\ijl15\$(Configuration)\ijl15.dll'))</Ijl15Output>
    <!-- PowerShell 7 if installed, otherwise fall back to Windows PowerShell 5.1 -->
    <Ijl15PowerShell Condition="'$(Ijl15PowerShell)' == '' and Exists('$(ProgramFiles)\PowerShell\7\pwsh.exe')">"$(ProgramFiles)\PowerShell\7\pwsh.exe"</Ijl15PowerShell>
    <Ijl15PowerShell Condition="'$(Ijl15PowerShell)' == '' and Exists('$(LocalAppData)\Microsoft\WindowsApps\pwsh.exe')">"$(LocalAppData)\Microsoft\WindowsApps\pwsh.exe"</Ijl15PowerShell>
    <Ijl15PowerShell Condition="'$(Ijl15PowerShell)' == ''">powershell.exe</Ijl15PowerShell>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DFLegacy.Protocol/DFLegacy.Protocol.csproj" />
    <ProjectReference Include="../DFLegacy.Ijl15/DFLegacy.Ijl15.vcxproj"
                      ReferenceOutputAssembly="false"
                      Condition="'$(MSBuildRuntimeType)' != 'Core'" />
    <Content Include="../../launcher.json" Link="launcher.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../DFLegacy.Ijl15/Config.ini" Link="Config.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildIjl15"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildRuntimeType)' == 'Core'">
    <Exec Command="$(Ijl15PowerShell) -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(Ijl15BuildScript)&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>
  <Target Name="CopyIjl15ToOutput"
          AfterTargets="Build"
          DependsOnTargets="BuildIjl15"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(Ijl15Output)"
          DestinationFiles="$(TargetDir)ijl15.dll"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyIjl15ToPublish"
          AfterTargets="Publish"
          DependsOnTargets="BuildIjl15"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(Ijl15Output)"
          DestinationFiles="$(PublishDir)ijl15.dll"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
